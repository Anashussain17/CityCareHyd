PORT=5717
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/reportmla
JWT_SECRET=a-long-random-string

# Frontend address(es) allowed to call the API, comma-separated.
# Leave empty to allow any origin (local development only).
CORS_ORIGINS=https://reportmla.anashussain.xyz

# Resend (email). The sender's domain must be verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=ReportMLA <updates@anashussain.xyz>

# Cloudinary (photos). Without these, photos are saved to local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
